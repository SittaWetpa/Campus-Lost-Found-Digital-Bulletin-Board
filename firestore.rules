rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users: any authenticated user may read (needed to display poster names);
    // writes are still restricted to the owner only.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.emailVerified == false
                    && request.resource.data.createdAt == request.time;
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && !request.resource.data.diff(resource.data)
                        .affectedKeys().hasAny(['emailVerified', 'createdAt']);
    }

    // OTP verifications: Admin SDK only — no client access
    match /otp_verifications/{uid} {
      allow read, write: if false;
    }

    // Mail: Trigger Email Extension only — no client access
    match /mail/{docId} {
      allow read, write: if false;
    }

    // Items: any authenticated user may read; only the Poster may create/edit/delete
    match /items/{itemId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && (
                      !request.resource.data.isSensitive
                      || (
                        request.resource.data.category == 'founder'
                        && request.resource.data.expiresAt is timestamp
                      )
                    );
      allow update, delete: if request.auth != null
                            && resource.data.userId == request.auth.uid
                            && !request.resource.data.diff(resource.data)
                                .affectedKeys().hasAny(['isSensitive', 'expiresAt']);

      // Private sub-collection: secret answer — poster only
      match /private/{doc} {
        allow read, write: if request.auth != null
                           && get(/databases/$(database)/documents/items/$(itemId)).data.userId == request.auth.uid;
      }

      // Requests sub-collection
      match /requests/{requestId} {
        allow create: if request.auth != null
                      && request.resource.data.requesterId == request.auth.uid;
        allow read: if request.auth != null
                    && (resource.data.requesterId == request.auth.uid
                        || get(/databases/$(database)/documents/items/$(itemId)).data.userId == request.auth.uid);
        allow update: if request.auth != null
                      && (resource.data.requesterId == request.auth.uid
                          || get(/databases/$(database)/documents/items/$(itemId)).data.userId == request.auth.uid)
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      }
    }
  }
}
